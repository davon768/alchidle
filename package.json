{
  "name": "alchemy-idle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "setup": "npm install && node scripts/claude-sync.mjs setup",
    "sync:status": "node scripts/claude-sync.mjs status",
    "sync:pull": "node scripts/claude-sync.mjs pull",
    "sync:push": "node scripts/claude-sync.mjs push",
    "bot": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register-ts.mjs scripts/balance-bot.ts"
  },
  "dependencies": {
    "lit-html": "^3.3.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
